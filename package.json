{
  "name": "compdesk",
  "version": "1.0.0-rc1",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "clean": "node scripts/clean-build.js",
    "prebuild": "npm run clean",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:rehearse": "node scripts/restore-rehearsal.mjs",
    "validate:env": "node scripts/validate-runtime-env.mjs",
    "generate:settings-key": "node scripts/generate-settings-key.mjs",
    "start": "node scripts/launch.mjs",
    "start:app": "npm run validate:env && node scripts/migrate-private-attachments.mjs && node scripts/start-standalone.mjs",
    "setup:bootstrap": "node scripts/launch.mjs --setup",
    "setup:docker:prepare": "node scripts/prepare-docker-setup.mjs",
    "setup:docker:import": "node scripts/import-legacy-deployment.mjs",
    "setup:recover": "node scripts/setup-recovery.mjs",
    "docker:reset": "node scripts/docker-reset.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:remove": "node scripts/remove-demo-data.mjs",
    "db:reset": "prisma migrate reset --force",
    "db:up": "docker compose -f docker-compose.dev.yml up -d db",
    "db:down": "docker compose -f docker-compose.dev.yml stop db",
    "setup": "npm run db:generate && npm run db:migrate:prod",
    "verify": "npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "relay:dependencies": "node scripts/dependency-relay.mjs",
    "relay:dependencies:windows": "pwsh -NoProfile -File scripts/npm-relay.ps1",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --runInBand --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate",
    "test:migration:upgrade": "node scripts/validate-migration-upgrade.mjs",
    "test:integration:entra": "node --test scripts/entra-account-link.integration.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "^3.9.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.66.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.474.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.56.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.0",
    "jest": "29.7.0",
    "postcss": "8.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
