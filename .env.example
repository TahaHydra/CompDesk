# ── CompDesk Environment Configuration ──────────────────────────
# Copy this file to .env and fill in the values.
# See docs/DEPLOYMENT.md for detailed setup instructions.

# ── Database ────────────────────────────────────────────────────
# Docker exposes PostgreSQL on 5433 by default to avoid port collisions.
POSTGRES_PORT="5433"
POSTGRES_VOLUME_NAME="compdesk_pgdata"
POSTGRES_VOLUME_EXTERNAL="false"
DATABASE_URL="postgresql://excodesk:excodesk_pass@localhost:5433/excodesk?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-32-char-random-string"
# Break-glass policy used if the settings database cannot be read at startup
LOGIN_LOCAL_ENABLED="true"
LOGIN_MICROSOFT_ENABLED="false"

# ── Microsoft Entra ID (Azure AD) ──────────────────────────────
# Leave empty to disable SSO and use only local login
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── Encrypted database settings ────────────────────────────────
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
APP_SETTINGS_ENCRYPTION_KEY=""
# During rotation, put the old key here, save/migrate the secret, then remove it.
APP_SETTINGS_ENCRYPTION_KEY_PREVIOUS=""
# ── SMTP (Nodemailer) ──────────────────────────────────────────
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="noreply@yourorg.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="CompDesk <noreply@yourorg.com>"

# External API clients and webhook secrets are managed by Super Admins in the application.
# The external API is disabled by default on clean installations.

# ── App Settings ────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"
UPLOAD_MAX_SIZE_MB="10"
TEMP_ATTACHMENT_TTL_HOURS="24"
TEMP_ATTACHMENT_MAX_FILES_PER_USER="20"
TEMP_ATTACHMENT_MAX_BYTES_PER_USER="104857600"
# Private ticket files; use durable shared storage in production
ATTACHMENT_STORAGE_DIR="storage/attachments"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
