# ── ExcoDesk Environment Configuration ──────────────────────────
# Copy this file to .env and fill in the values.
# See docs/DEPLOYMENT.md for detailed setup instructions.

# ── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://excodesk:excodesk_pass@localhost:5432/excodesk?schema=public"

# ── NextAuth / Auth.js ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-32-char-random-string"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="same-value-as-NEXTAUTH_SECRET"

# ── Microsoft Entra ID (Azure AD) ──────────────────────────────
# Leave empty to disable SSO and use only local login
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ── SMTP (Nodemailer) ──────────────────────────────────────────
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@yourorg.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="ExcoDesk <noreply@yourorg.com>"

# ── External API ────────────────────────────────────────────────
API_KEY="replace-with-a-secure-api-key"

# ── Webhooks ────────────────────────────────────────────────────
WEBHOOK_URL=""
WEBHOOK_SECRET="replace-with-webhook-signing-secret"

# ── App Settings ────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"
UPLOAD_MAX_SIZE_MB="10"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
